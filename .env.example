# Optional Capacitor development server URL for local hot reload.
# Leave unset for production/Play Store builds so the app uses bundled dist/ assets.
# CAPACITOR_SERVER_URL=http://localhost:8080
# CAPACITOR_ALLOW_CLEARTEXT=true

# Vite/Supabase values are intentionally placeholders; do not commit real secrets.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key
